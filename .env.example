# Server
PORT=3000

# Comma-separated list of allowed frontend origins (no trailing slash).
# Include both the portfolio and the Airbnb guest guide frontends, e.g.:
# FRONTEND_URL=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# MongoDB connection string.
# Local development (e.g. MongoDB Compass / local mongod on default port):
MONGODB_URI=mongodb://127.0.0.1:27017/MARIAN_PORTFOLIO
# Production (MongoDB Atlas free M0 tier), example:
# MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/MARIAN_PORTFOLIO

# Resend (https://resend.com) — free tier available
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address used for outgoing emails.
# On Resend's free tier, until you verify your own domain, you must use
# "onboarding@resend.dev" here — Resend blocks any other "from" address.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Where the "someone contacted you" notification email is delivered
CONTACT_RECEIVER_EMAIL=mariano.maciasgandulfo@gmail.com

# Where "a guest left a recommendation" emails (Airbnb guest guide) are
# delivered. Optional — falls back to CONTACT_RECEIVER_EMAIL if unset.
# AIRBNB_RECEIVER_EMAIL=mariano.maciasgandulfo@gmail.com

# Where "new newsletter subscriber" emails (TechPRO / audifonos) are
# delivered. Optional — falls back to CONTACT_RECEIVER_EMAIL if unset.
# AUDIFONOS_RECEIVER_EMAIL=mariano.maciasgandulfo@gmail.com
