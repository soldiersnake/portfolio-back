# Server
PORT=3000

# Comma-separated list of allowed frontend origins (no trailing slash).
# Include both the portfolio and the Airbnb guest guide frontends, e.g.:
# FRONTEND_URL=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# MongoDB connection string.
# Local development (e.g. MongoDB Compass / local mongod on default port):
MONGODB_URI=mongodb://127.0.0.1:27017/MARIAN_PORTFOLIO
# Production (MongoDB Atlas free M0 tier), example:
# MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/MARIAN_PORTFOLIO

# Resend (https://resend.com) — free tier available
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address used for outgoing emails.
# On Resend's free tier, until you verify your own domain, you must use
# "onboarding@resend.dev" here — Resend blocks any other "from" address.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Where the "someone contacted you" notification email is delivered
CONTACT_RECEIVER_EMAIL=mariano.maciasgandulfo@gmail.com

# Where "a guest left a recommendation" emails (Airbnb guest guide) are
# delivered. Optional — falls back to CONTACT_RECEIVER_EMAIL if unset.
# AIRBNB_RECEIVER_EMAIL=mariano.maciasgandulfo@gmail.com

# Where "new newsletter subscriber" emails (TechPRO / audifonos) are
# delivered. Optional — falls back to CONTACT_RECEIVER_EMAIL if unset.
# AUDIFONOS_RECEIVER_EMAIL=mariano.maciasgandulfo@gmail.com

# Where TiendaMueble's contact form notifications are delivered.
# Optional — falls back to CONTACT_RECEIVER_EMAIL if unset.
# TIENDA_MUEBLE_RECEIVER_EMAIL=mariano.maciasgandulfo@gmail.com

# Where arquitectura's contact/consultation form notifications are delivered.
# Optional — falls back to CONTACT_RECEIVER_EMAIL if unset.
# ARQUITECTURA_RECEIVER_EMAIL=mariano.maciasgandulfo@gmail.com

# --- TiendaMueble: login + admin CRUD ---

# Google OAuth Web client ID (console.cloud.google.com > APIs & Services >
# Credentials > Create Credentials > OAuth client ID > Web application).
# Add both http://localhost:5175 (or whatever port Vite uses for this app)
# and your deployed domain under "Authorized JavaScript origins".
# Same value goes in the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Only this email gets admin rights (product CRUD) after logging in with
# Google — every other logged-in email can browse/buy but not manage products.
TIENDA_MUEBLE_ADMIN_EMAIL=mariano.maciasgandulfo@gmail.com

# Secret used to sign this app's own JWTs (issued after verifying the Google
# login). Any long random string — e.g. `openssl rand -hex 32`.
TIENDA_MUEBLE_JWT_SECRET=change-me-to-a-long-random-string

# ImageKit (https://imagekit.io) — free tier, used to store images for
# products created from the admin CRUD (the original 6 products keep using
# static files in /img/productos, no ImageKit needed for those).
# Dashboard > Developer options > API keys.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Stripe (https://dashboard.stripe.com) — pagos de TiendaMueble (tarjeta +
# Bizum). Usar las claves de TEST mientras se prueba (empiezan con sk_test_ /
# whsec_...), no las de producción.
# STRIPE_SECRET_KEY: Dashboard > Developers > API keys > Secret key.
# STRIPE_WEBHOOK_SECRET: Dashboard > Developers > Webhooks > (tu endpoint) >
# Signing secret. En local, `stripe listen` (Stripe CLI) te da uno propio de
# prueba — ver instrucciones aparte.
STRIPE_SECRET_KEY=sk_test_tu_clave_aqui
STRIPE_WEBHOOK_SECRET=sk_test_tu_clave_aqui

# A dónde redirige Stripe después del pago (success_url/cancel_url). OJO:
# NO usar FRONTEND_URL para esto — esa variable es la lista de orígenes de
# CORS (varios proyectos separados por coma) y tomar el primero de la lista
# redirige siempre al proyecto equivocado. Esta variable es solo para
# TiendaMueble, un único origen, sin coma ni slash final:
TIENDA_MUEBLE_FRONTEND_URL=http://localhost:5175
# En producción, apuntar a tu dominio real, ej:
# TIENDA_MUEBLE_FRONTEND_URL=https://tiendamueble.marianomaciasgandulfo.com

# Mercado Pago (https://www.mercadopago.com.ar/developers) — segundo medio de
# pago de TiendaMueble, pensado para compradores en Argentina (cobra en ARS,
# ver EUR_TO_ARS_RATE en mercadopago.service.ts). Usar las credenciales de
# TEST mientras se prueba (Dashboard > Tus integraciones > (tu app) >
# Credenciales de prueba), no las de producción.
# MERCADOPAGO_ACCESS_TOKEN: credencial de prueba/producción, Access Token.
MERCADOPAGO_ACCESS_TOKEN=TEST-tu-access-token-aqui
# MERCADOPAGO_WEBHOOK_SECRET: Dashboard > Tus integraciones > (tu app) >
# Webhooks > Firma secreta. Distinto del ACCESS_TOKEN.

# --- GymBro: auth, perfil de socios ---

# Secret usado para firmar los JWT propios de GymBro (issued tras verificar
# login por Google o email/contraseña). String largo y random, ej.
# `openssl rand -hex 32`. Distinto del de TiendaMueble — cada app tiene el suyo.
GYM_JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth Web client ID propio de GymBro (proyecto/cliente separado del
# de TiendaMueble en Google Cloud — ver PLANNING.md "Resuelto ronda 2").
# console.cloud.google.com > APIs & Services > Credentials > Create
# Credentials > OAuth client ID > Web application. Agregar tanto
# http://localhost:5177 (o el puerto que termine usando el frontend de
# GymBro) como el dominio real en "Authorized JavaScript origins". Mismo
# valor va en el frontend como VITE_GYM_GOOGLE_CLIENT_ID.
GYM_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# URL del frontend de GymBro, usada solo para armar el link absoluto de
# "aceptar invitación" que recibe por mail un socio dado de alta a mano por
# un admin (ver EmailService.sendGymInviteEmail). NO confundir con
# FRONTEND_URL (lista de orígenes CORS) — esta es un único origen, sin coma
# ni slash final.
GYM_FRONTEND_URL=http://localhost:5177
# En producción, apuntar al dominio real, ej:
# GYM_FRONTEND_URL=https://gymbro.marianomaciasgandulfo.com

# Sign in with Apple: reservado para cuando exista la cuenta de Apple
# Developer (ver PLANNING.md sección 3, "Sobre Apple Sign In"). Con el flag
# ausente/false, el botón "Continuar con Apple" queda oculto en el frontend.
# GYM_APPLE_AUTH_ENABLED=false

# --- GymBro: pagos (Fase 2 del roadmap, ver PLANNING.md sección 5) ---

# GymBro puede operar con Stripe, Mercado Pago, los dos, o ninguno (cobro a
# mano mientras Mariano prueba el resto de la app) — a diferencia de
# TiendaMueble, acá cada proveedor necesita su flag ENABLED explícito además
# de las credenciales (ver GymStripeService/GymMercadoPagoService.isConfigured).
# GYM_STRIPE_ENABLED=false
# GYM_MERCADOPAGO_ENABLED=false

# Mismas claves de TEST que en la sección de TiendaMueble más arriba, pero en
# un proyecto/dashboard de Stripe separado (ver PLANNING.md sección 2.7 y 5 —
# no mezclar los dos proyectos en el mismo dashboard).
# GYM_STRIPE_SECRET_KEY=sk_test_tu_clave_aqui
# GYM_STRIPE_WEBHOOK_SECRET=whsec_tu_clave_aqui

# Credenciales de prueba de Mercado Pago, también en una app separada de la
# de TiendaMueble. A diferencia de TiendaMueble (que cobra en ARS), GymBro
# cobra en EUR directo — ver gym-mercadopago.service.ts.
# GYM_MERCADOPAGO_ACCESS_TOKEN=TEST-tu-access-token-aqui
# GYM_MERCADOPAGO_WEBHOOK_SECRET=tu-firma-secreta-aqui

# --- GymBro: clases y notificaciones (Fase 3 del roadmap, ver PLANNING.md sección 5) ---

# Claves VAPID para Web Push (PWA) — a diferencia de Stripe/MercadoPago no
# hay flag *_ENABLED separado: si las dos claves están, push queda activo
# (ver GymWebPushService.isConfigured). Sin ellas, GymBro sigue funcionando
# igual (clases, lista de espera, anuncios) pero solo por email — el push
# simplemente no se dispara. Generar un par propio con:
#   npx web-push generate-vapid-keys
# (no reutilizar el mismo par entre entornos/proyectos).
# GYM_VAPID_PUBLIC_KEY=tu-clave-publica-aqui
# GYM_VAPID_PRIVATE_KEY=tu-clave-privada-aqui
# GYM_VAPID_SUBJECT=mailto:mariano.maciasgandulfo@gmail.com

# Secreto compartido para POST /gym/reminders/expiring-soon (recordatorio de
# membresía próxima a vencer, push + email — ver GymRemindersController).
# Sin cron nativo en este backend (ver membership-expiration.util.ts), así
# que lo dispara una GitHub Action diaria mandando este mismo valor en el
# header `x-cron-secret` (ver .github/workflows/gym-membership-reminders.yml
# y el secret GYM_CRON_SECRET del repo en GitHub). Sin esta env var el
# endpoint queda cerrado por completo, nunca "abierto por defecto". String
# largo y random, ej. `openssl rand -hex 32`.
# GYM_CRON_SECRET=change-me-to-a-long-random-string
